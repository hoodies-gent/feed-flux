# FeedFlux Configuration Example

# Microsoft Graph Credentials
# Register app at Azure Portal to get Client ID
MS_CLIENT_ID=your_client_id_here

# LLM Provider (deepseek | glm | gemini)
LLM_PROVIDER=deepseek

# API Keys
# Get your key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Get your key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Get your key from: https://open.bigmodel.cn/usercenter/apikeys
GLM_API_KEY=your_glm_api_key_here

# App Settings
LOG_LEVEL=INFO

# Model Override (Optional)
# DEEPSEEK_MODEL_NAME=deepseek-chat
# GLM_MODEL_NAME=glm-4.7
# GEMINI_MODEL_NAME=gemini-flash-lite-latest
# LLM_TEMPERATURE=0.2
